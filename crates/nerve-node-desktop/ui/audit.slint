// Audit: every decision of the node, newest first, with the four buttons of
// issue #23 on a call: allow, allow as wildcard, deny, deny as wildcard.
// They write the rule `nerve-node rule add --action` writes, the one the
// center's audit page writes.

import { Theme, Type, Space, Radius, Tone } from "theme.slint";
import { Load, AuditRow } from "data.slint";
import { Store } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, IconTile, Banner, Loading, PageHeader, PageFrame,
    EmptyState, Divider, Segmented, Code, Reveal, Fit, MoreFoot,
} from "widgets.slint";

component AuditEntry {
    in property <AuditRow> entry;
    property <bool> waiting: Store.busy == "audit-" + root.entry.index;
    HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.lg;
        padding-bottom: Space.lg;
        spacing: Space.lg;
        VerticalLayout {
            alignment: start;
            IconTile {
                size: 32px;
                tone: root.entry.tone;
                icon: root.entry.kind == "call" ? (root.entry.tone == Tone.danger ? @image-url("icons/ban.svg") : @image-url("icons/check.svg"))
                    : root.entry.kind == "settings" ? @image-url("icons/sliders.svg")
                    : root.entry.kind == "relay" ? @image-url("icons/globe.svg")
                    : root.entry.kind == "key" ? @image-url("icons/key.svg")
                    : root.entry.kind == "config" ? @image-url("icons/edit.svg")
                    : @image-url("icons/info.svg");
            }
        }
        // Its parts come and go with the entry, each with the gap above it
        // (see Reveal).
        VerticalLayout {
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: Space.sm;
                Text {
                    text: root.entry.title;
                    color: Theme.text;
                    font-size: Type.body;
                    font-weight: Type.semibold;
                    font-family: root.entry.kind == "call" ? Type.mono : "";
                    vertical-alignment: center;
                }
                if root.entry.badge != "": VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.entry.badge;
                        tone: root.entry.tone;
                    }
                }
                if root.entry.center != "": Text {
                    text: root.entry.center;
                    color: Theme.text-muted;
                    font-size: Type.small;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: min(40px, self.preferred-width);
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.entry.when;
                    color: Theme.text-faint;
                    font-size: Type.caption;
                    vertical-alignment: center;
                    accessible-label: root.entry.when-exact;
                }
            }
            Reveal {
                shown: root.entry.target != "";
                gap: Space.sm;
                Code {
                    text: root.entry.target;
                }
            }
            Reveal {
                shown: root.entry.detail != "";
                gap: Space.sm;
                Text {
                    text: root.entry.detail;
                    color: Theme.text-muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
            Reveal {
                shown: root.entry.rules;
                gap: Space.sm + 2px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Button {
                        text: "Allow";
                        icon: @image-url("icons/check.svg");
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "allow", false);
                        }
                    }
                    Button {
                        text: "Allow as wildcard";
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "allow", true);
                        }
                    }
                    Rectangle {
                        width: Space.xs;
                    }
                    Button {
                        text: "Deny";
                        icon: @image-url("icons/ban.svg");
                        kind: ButtonKind.danger-soft;
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "deny", false);
                        }
                    }
                    Button {
                        text: "Deny as wildcard";
                        kind: ButtonKind.danger-soft;
                        small: true;
                        enabled: !root.waiting;
                        clicked => {
                            Store.audit-rule(root.entry.index, "deny", true);
                        }
                    }
                }
            }
            Reveal {
                shown: !root.entry.rules && root.entry.rules-why != "";
                gap: Space.sm;
                Text {
                    text: root.entry.rules-why;
                    color: Theme.text-faint;
                    font-size: Type.caption;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AuditPage inherits PageFrame {
    gap: 0;
    PageHeader {
        title: "Audit";
        subtitle: "What the node allowed and refused, newest first, and every change to its settings.";
        error-title: "The audit log could not be read";
        error: Store.audit-error;
        error-action: "Try again";
        error-acted => {
            Store.refresh-audit();
        }
        Segmented {
            options: ["All", "Refused"];
            current: Store.audit-refused-only ? 1 : 0;
            chosen(i) => {
                Store.audit-filter(i == 1);
            }
        }
        Button {
            text: "Refresh";
            icon: @image-url("icons/refresh.svg");
            kind: ButtonKind.ghost;
            clicked => {
                Store.refresh-audit();
            }
        }
    }

    if Store.audit-load == Load.loading && Store.audit-total == 0: Loading {
        text: "Reading the audit log…";
    }

    Reveal {
        shown: Store.audit-load == Load.ready && Store.audit.length == 0;
        gap: Space.xxl;
        Card {
            EmptyState {
                icon: @image-url("icons/audit.svg");
                title: Store.audit-refused-only ? "Nothing was refused" : "Nothing decided yet";
                text: Store.audit-refused-only
                    ? "Every call so far was allowed. Refused calls show here, with buttons to allow them."
                    : "When a center calls this machine, the node's decision shows here, and so does every change to its settings.";
            }
        }
    }

    Reveal {
        shown: Store.audit.length > 0;
        gap: Space.xxl;
        Card {
            pad: 0;
            gap: 0;
            for row[i] in Store.audit: Fit {
                Divider {
                    visible: i > 0;
                    height: i > 0 ? 1px : 0;
                }
                AuditEntry {
                    entry: row;
                }
            }
        }
    }

    Reveal {
        shown: Store.audit.length >= Store.audit-limit;
        gap: Space.lg;
        MoreFoot {
            text: Store.audit-limit < 1000 ? "The newest " + Store.audit.length + " entries."
                : "The newest " + Store.audit.length + " entries. The node keeps the older ones in its audit log.";
            more: Store.audit-limit < 1000;
            clicked => {
                Store.audit-more();
            }
        }
    }
}
