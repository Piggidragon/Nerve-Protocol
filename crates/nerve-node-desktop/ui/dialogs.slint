// The dialogs: pairing a center, confirming a change that cannot be undone,
// and About with Slint's AboutSlint, as Slint's Royalty-free license asks.

import { AboutSlint } from "std-widgets.slint";
import { Theme, Type, Space, Radius, Tone } from "theme.slint";
import { Store, Perm, Prefs, Install } from "store.slint";
import { Working, DidList, UninstallChoice, UpdateChoice } from "installer.slint";
import {
    Button, ButtonKind, Banner, Dialog, DialogButtons, Field, TextField, InfoRow, Divider, Code,
    Icon, CheckBox, Segmented, TextArea, CopyText, OptionTile, Steps, Reveal,
} from "widgets.slint";

export component PairDialog inherits Dialog {
    title: Store.pair-step == 0 ? "Pair a center" : "Pair with this center?";
    subtitle: Store.pair-step == 0
        ? "Paste the pairing link the center's web UI shows under Pair a machine. Nothing is paired until you confirm."
        : "Check that this is the center you mean. It gets nothing yet: a new center may do nothing until you allow it.";
    close => {
        Store.pair-open = false;
    }

    // One step at a time; both stay in place (see Reveal).
    VerticalLayout {
    Reveal {
        shown: Store.pair-step == 0;
      VerticalLayout {
        spacing: Space.lg;
        Field {
            label: "Pairing link";
            link := TextField {
                text <=> Store.pair-link;
                placeholder: "nerve://pair?center=…";
                mono: true;
                label: "Pairing link";
                invalid: Store.pair-error != "";
                enabled: !Store.pair-busy;
                accepted => {
                    Store.pair-check(Store.pair-link, Store.pair-name);
                }
                init => {
                    self.focus();
                }
            }
        }
        Field {
            label: "Name on this machine";
            hint: "Optional. Leave it empty to take the center's own name.";
            TextField {
                text <=> Store.pair-name;
                placeholder: "home-lab";
                label: "Name on this machine";
                enabled: !Store.pair-busy;
                accepted => {
                    Store.pair-check(Store.pair-link, Store.pair-name);
                }
            }
        }
        DialogButtons {
            error: Store.pair-error;
            Button {
                text: "Cancel";
                kind: ButtonKind.ghost;
                clicked => {
                    Store.pair-open = false;
                }
            }
            Button {
                text: "Continue";
                kind: ButtonKind.primary;
                enabled: Store.pair-link != "";
                busy: Store.pair-busy;
                clicked => {
                    Store.pair-check(Store.pair-link, Store.pair-name);
                }
            }
        }
      }
    }

    Reveal {
        shown: Store.pair-step == 1;
      VerticalLayout {
        spacing: Space.lg;
        VerticalLayout {
        Rectangle {
            background: Theme.surface-alt;
            border-radius: Radius.lg;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Space.lg;
                spacing: Space.md;
                InfoRow {
                    label: "Center";
                    value: Store.pair-preview.center;
                    mono: true;
                }
                InfoRow {
                    label: "Certificate";
                    value: !Store.pair-preview.tls ? "None: plain http, nothing on the way is encrypted"
                        : Store.pair-preview.pin != "" ? "Pinned: " + Store.pair-preview.pin
                        : "Checked against the system's roots";
                    mono: Store.pair-preview.tls && Store.pair-preview.pin != "";
                    tone: Store.pair-preview.tls ? Tone.neutral : Tone.danger;
                }
                InfoRow {
                    label: "Name here";
                    value: Store.pair-preview.name != "" ? Store.pair-preview.name : "The center's own name";
                }
            }
        }
        Reveal {
            shown: !Store.pair-preview.tls;
            gap: Space.lg;
            Banner {
                tone: Tone.warn;
                title: "This link is not encrypted";
                text: "Anyone on the way can read and change what goes between this machine and the center. Pair over plain http only on a network you trust.";
            }
        }
        }
        VerticalLayout {
            spacing: 6px;
            Text {
                text: "The center starts with";
                color: Theme.text;
                font-size: Type.small;
                font-weight: Type.semibold;
            }
            HorizontalLayout {
                spacing: Space.sm;
                VerticalLayout {
                    alignment: start;
                    padding-top: 2px;
                    Icon {
                        source: @image-url("icons/shield.svg");
                        colorize: Theme.ok;
                        size: 14px;
                    }
                }
                Text {
                    text: "Allowlist mode: nothing is allowed until you add an allow rule or choose a mode.";
                    color: Theme.text-muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: Space.sm;
                VerticalLayout {
                    alignment: start;
                    padding-top: 2px;
                    Icon {
                        source: @image-url("icons/lock.svg");
                        colorize: Theme.ok;
                        size: 14px;
                    }
                }
                Text {
                    text: "No settings grant: the center cannot change what it may do.";
                    color: Theme.text-muted;
                    font-size: Type.small;
                    wrap: word-wrap;
                }
            }
        }
        DialogButtons {
            error: Store.pair-error;
            error-title: "Not paired";
            Button {
                text: "Back";
                icon: @image-url("icons/arrow-left.svg");
                kind: ButtonKind.ghost;
                enabled: !Store.pair-busy;
                clicked => {
                    Store.pair-error = "";
                    Store.pair-step = 0;
                }
            }
            Button {
                text: "Pair";
                icon: @image-url("icons/link.svg");
                kind: ButtonKind.primary;
                busy: Store.pair-busy;
                clicked => {
                    Store.pair-confirm();
                }
            }
        }
      }
    }
    }
}

export component ConfirmDialog inherits Dialog {
    title: Store.confirm-title;
    subtitle: Store.confirm-text;
    card-width: 460px;
    close => {
        Store.confirm-open = false;
    }
    Reveal {
        shown: Store.confirm-option != "";
        CheckBox {
            text: Store.confirm-option;
            detail: Store.confirm-option-detail;
            checked: Store.confirm-option-on;
            toggled(on) => {
                Store.confirm-option-on = on;
            }
        }
    }
    DialogButtons {
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Store.confirm-open = false;
            }
        }
        Button {
            text: Store.confirm-button;
            kind: ButtonKind.danger;
            clicked => {
                Store.confirm-open = false;
                Store.confirm-accepted();
            }
        }
    }
}

export component AboutDialog inherits Dialog {
    title: "About";
    card-width: 440px;
    close => {
        Store.about-open = false;
    }
    VerticalLayout {
        spacing: Space.sm;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/app.svg");
                width: 64px;
                height: 64px;
            }
        }
        Text {
            text: "Nerve node";
            color: Theme.text;
            font-size: 18px;
            font-weight: Type.semibold;
            horizontal-alignment: center;
        }
        Text {
            text: "Version " + Store.version;
            color: Theme.text-muted;
            font-size: Type.small;
            horizontal-alignment: center;
        }
        Text {
            text: "The desktop app of the Nerve node. Every action runs nerve-node, so it has the command line's checks and writes the same audit records.";
            color: Theme.text-muted;
            font-size: Type.small;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: Space.xs;
            Button {
                text: "Project page";
                icon: @image-url("icons/external.svg");
                kind: ButtonKind.ghost;
                small: true;
                clicked => {
                    Platform.open-url("https://github.com/Piggidragon/Nerve-Protocol");
                }
            }
        }
    }
    Divider { }
    AboutSlint {
        preferred-height: self.min-height;
    }
}

export component ModeDialog inherits Dialog {
    title: Perm.mode-choice == "folder" ? "Folder mode for " + Perm.center : "User mode for " + Perm.center;
    subtitle: Perm.mode-choice == "folder"
        ? "The center may do what each of its folders allows, in that folder."
        : "The center may do anything you could do yourself on this machine, its protected files aside. Use it for a while, not for good.";
    card-width: 480px;
    close => {
        Perm.mode-open = false;
    }
    VerticalLayout {
        Segmented {
            options: ["Until I change it", "For a time"];
            current: Perm.mode-timed ? 1 : 0;
            chosen(i) => {
                Perm.mode-timed = i == 1;
            }
        }
        Reveal {
            shown: Perm.mode-timed;
            gap: Space.md;
            Field {
                label: "Hours";
                hint: "Then the center goes back to allowlist mode by itself.";
                TextField {
                    text <=> Perm.mode-hours;
                    label: "Hours";
                    accepted => {
                        Perm.mode-apply();
                    }
                }
            }
        }
    }
    DialogButtons {
        error: Perm.mode-error;
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Perm.mode-open = false;
            }
        }
        Button {
            text: "Switch";
            kind: ButtonKind.primary;
            clicked => {
                Perm.mode-apply();
            }
        }
    }
}

export component FolderDialog inherits Dialog {
    title: "Add a folder";
    subtitle: "What may " + Perm.center + " do in it? A folder's rights count in folder mode.";
    card-width: 520px;
    close => {
        Perm.folder-open = false;
    }
    Code {
        text: Perm.folder-path;
    }
    VerticalLayout {
        spacing: Space.md;
        CheckBox {
            text: "Read";
            detail: "List, read and search its files.";
            checked: Perm.folder-read;
            toggled(on) => {
                Perm.folder-read = on;
            }
        }
        CheckBox {
            text: "Write";
            detail: "Change, add and delete files in it.";
            checked: Perm.folder-write;
            toggled(on) => {
                Perm.folder-write = on;
            }
        }
        CheckBox {
            text: "Run commands";
            detail: "Run commands in it, confined to the folders that allow it.";
            checked: Perm.folder-execute;
            toggled(on) => {
                Perm.folder-execute = on;
            }
        }
    }
    DialogButtons {
        error: Perm.folder-error;
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Perm.folder-open = false;
            }
        }
        Button {
            text: "Add";
            kind: ButtonKind.primary;
            enabled: Perm.folder-read || Perm.folder-write || Perm.folder-execute;
            clicked => {
                Perm.folder-add();
            }
        }
    }
}

export component SudoDialog inherits Dialog {
    title: "Turn sudo on";
    subtitle: "Your sudo password, which the running node keeps in memory only and forgets when sudo goes off or the node stops. On Windows, the password of the account commands run as.";
    card-width: 480px;
    close => {
        Perm.sudo-open = false;
    }
    Field {
        label: "Password";
        TextField {
            text <=> Perm.sudo-password;
            password: true;
            label: "Password";
            enabled: !Perm.sudo-busy;
            accepted => {
                Perm.sudo-confirm();
            }
            init => {
                self.focus();
            }
        }
    }
    DialogButtons {
        error: Perm.sudo-error;
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Perm.sudo-open = false;
            }
        }
        Button {
            text: "Turn on";
            kind: ButtonKind.primary;
            enabled: Perm.sudo-password != "";
            busy: Perm.sudo-busy;
            clicked => {
                Perm.sudo-confirm();
            }
        }
    }
}

export component ProxyDialog inherits Dialog {
    title: "Proxy";
    subtitle: "Every link to a center goes through it, a pairing too. Header values and the password are kept apart from node.toml.";
    card-width: 560px;
    close => {
        Prefs.proxy-open = false;
    }
    Field {
        label: "Proxy";
        hint: "http://host:port, http://user@host:port when it wants a login, or https://… for a relay.";
        TextField {
            text <=> Prefs.proxy-new-url;
            mono: true;
            placeholder: "http://proxy.example:3128";
            label: "Proxy";
        }
    }
    Field {
        label: "Password";
        hint: "Optional. The password of the user in the URL; it is kept apart from node.toml.";
        TextField {
            text <=> Prefs.proxy-new-password;
            password: true;
            label: "Password";
        }
    }
    Field {
        label: "Pin";
        hint: "Optional. The pin of an https:// proxy's certificate; a relay shows its own.";
        TextField {
            text <=> Prefs.proxy-new-pin;
            mono: true;
            label: "Pin";
        }
    }
    Field {
        label: "Headers";
        hint: "Optional. One a line, as Name: value.";
        TextArea {
            text <=> Prefs.proxy-new-headers;
            mono: true;
            label: "Headers";
            placeholder: "Proxy-Authorization: Bearer …";
        }
    }
    DialogButtons {
        error: Prefs.proxy-error;
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Prefs.proxy-open = false;
            }
        }
        Button {
            text: "Save";
            kind: ButtonKind.primary;
            enabled: Prefs.proxy-new-url != "";
            clicked => {
                Prefs.proxy-set();
            }
        }
    }
}

// A token shown once, with what the node said to do with it.
export component OnceDialog inherits Dialog {
    title: Prefs.once-title;
    subtitle: "It is shown only now: copy it to the other node.";
    card-width: 620px;
    close => {
        Prefs.once-open = false;
    }
    CopyText {
        text: Prefs.once-text;
    }
    DialogButtons {
        Button {
            text: "Done";
            kind: ButtonKind.primary;
            clicked => {
                Prefs.once-open = false;
            }
        }
    }
}

// A part of the desktop is missing for what the owner asked: what, and
// what to install.
export component MissingDialog inherits Dialog {
    title: Store.missing-title;
    subtitle: "Nerve needs a part of the desktop for this that is not on this machine.";
    card-width: 560px;
    close => {
        Store.missing-open = false;
    }
    DialogButtons {
        error: Store.missing-text;
        Button {
            text: "Close";
            kind: ButtonKind.primary;
            clicked => {
                Store.missing-open = false;
            }
        }
    }
}

export component BackupDialog inherits Dialog {
    title: "Back up this node";
    subtitle: "The config and the keys go into the file, sealed with the passphrase. Without it the file is no use to anyone, you included.";
    card-width: 540px;
    close => {
        Prefs.backup-open = false;
    }
    Code {
        text: Prefs.backup-file;
    }
    Field {
        label: "Passphrase";
        hint: "At least 12 characters.";
        TextField {
            text <=> Prefs.backup-pass;
            password: true;
            label: "Passphrase";
            init => {
                self.focus();
            }
        }
    }
    Field {
        label: "The passphrase again";
        TextField {
            text <=> Prefs.backup-pass2;
            password: true;
            label: "The passphrase again";
            invalid: Prefs.backup-pass2 != "" && Prefs.backup-pass2 != Prefs.backup-pass;
            accepted => {
                Prefs.backup-confirm();
            }
        }
    }
    CheckBox {
        text: "Take the keys in the system keyring too";
        detail: "Without it, keys kept in the keyring stay there and are left out of the file.";
        checked: Prefs.backup-keyring;
        toggled(on) => {
            Prefs.backup-keyring = on;
        }
    }
    DialogButtons {
        error: Prefs.backup-error;
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Prefs.backup-open = false;
            }
        }
        Button {
            text: "Back up";
            kind: ButtonKind.primary;
            busy: Prefs.backup-busy;
            enabled: Prefs.backup-pass != "" && Prefs.backup-pass == Prefs.backup-pass2;
            clicked => {
                Prefs.backup-confirm();
            }
        }
    }
}

export component RestoreDialog inherits Dialog {
    title: "Restore a backup";
    subtitle: "The backup's config and keys take the place of this node's. The node must not run.";
    card-width: 540px;
    close => {
        Prefs.restore-open = false;
    }
    Code {
        text: Prefs.restore-file;
    }
    Field {
        label: "Passphrase";
        TextField {
            text <=> Prefs.restore-pass;
            password: true;
            label: "Passphrase";
            accepted => {
                Prefs.restore-confirm();
            }
            init => {
                self.focus();
            }
        }
    }
    CheckBox {
        text: "It is the backup of another node";
        detail: "Replace the node here with it. Without this a backup of another node is refused.";
        checked: Prefs.restore-replace;
        toggled(on) => {
            Prefs.restore-replace = on;
        }
    }
    CheckBox {
        text: "Leave its proxy out";
        detail: "This machine reaches its centers in its own way; set a proxy here later.";
        checked: Prefs.restore-without-proxy;
        toggled(on) => {
            Prefs.restore-without-proxy = on;
        }
    }
    CheckBox {
        text: "Keep its keys in files here";
        detail: "For a backup of a machine that kept them in the system keyring, when this one has none or may not use it, as the installed node on Windows.";
        checked: Prefs.restore-in-files;
        toggled(on) => {
            Prefs.restore-in-files = on;
        }
    }
    DialogButtons {
        error: Prefs.restore-error;
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Prefs.restore-open = false;
            }
        }
        Button {
            text: "Restore";
            kind: ButtonKind.danger;
            busy: Prefs.restore-busy;
            enabled: Prefs.restore-pass != "";
            clicked => {
                Prefs.restore-confirm();
            }
        }
    }
}

// Why the app asks for administrator rights, before the system asks.
export component ElevateDialog inherits Dialog {
    title: "Administrator rights";
    subtitle: "The node on this machine is installed as a service. Its settings, keys and logs belong to the system, so reading and changing them takes administrator rights, as nerve-node with sudo (on Windows, as administrator) does in a terminal.";
    card-width: 520px;
    close => {
        Store.elevate-open = false;
    }
    Text {
        text: "The system asks you once, and the app keeps the rights while it is open. Every change still runs as a nerve-node command, with its checks and audit records.";
        color: Theme.text-muted;
        font-size: Type.small;
        wrap: word-wrap;
    }
    DialogButtons {
        error: Store.elevate-error;
        Button {
            text: "Not now";
            kind: ButtonKind.ghost;
            clicked => {
                Store.elevate-open = false;
            }
        }
        Button {
            text: "Continue";
            icon: @image-url("icons/shield.svg");
            kind: ButtonKind.primary;
            busy: Store.elevate-busy;
            clicked => {
                Store.elevate-allow();
            }
        }
    }
}

// Settings: update the app and the node, from the latest release or a file.
export component UpdateDialog inherits Dialog {
    title: Install.step == "done" ? "Nerve is updated to " + Install.installed-version : "Update Nerve";
    subtitle: Install.step == "done" ? (Install.installed-version == Install.version ? "Nerve was up to date: the program is the one that is installed." : "The service runs the new version. Restart Nerve to use it here too.")
        : Install.step == "working" ? ""
        : "Version " + Install.version + " is installed. An update replaces the program, puts its menu entry back and restarts the service. The node's settings, keys and audit log stay.";
    card-width: 560px;
    close => {
        if (Install.step != "working") {
            Install.update-open = false;
        }
    }
    VerticalLayout {
        Reveal {
            shown: Install.step == "choose";
            VerticalLayout {
                spacing: Space.xl;
                UpdateChoice { }
                DialogButtons {
                    error: Install.error;
                    error-title: Install.error-title != "" ? Install.error-title : "The update did not finish";
                    Button {
                        text: "Cancel";
                        kind: ButtonKind.ghost;
                        clicked => {
                            Install.update-open = false;
                        }
                    }
                    Button {
                        text: "Update";
                        icon: @image-url("icons/download.svg");
                        kind: ButtonKind.primary;
                        enabled: Install.source == 0 || Install.file != "";
                        clicked => {
                            Install.update();
                        }
                    }
                }
            }
        }
        Reveal {
            shown: Install.step == "working";
            Working { }
        }
        Reveal {
            shown: Install.step == "done";
            VerticalLayout {
                spacing: Space.xl;
                DidList { }
                DialogButtons {
                    Button {
                        text: "Later";
                        kind: ButtonKind.ghost;
                        clicked => {
                            Install.update-open = false;
                        }
                    }
                    Button {
                        text: "Restart Nerve";
                        icon: @image-url("icons/refresh.svg");
                        kind: ButtonKind.primary;
                        clicked => {
                            Install.open-app();
                        }
                    }
                }
            }
        }
    }
}

// Settings: remove the node, the app and, if chosen, the node's data.
export component UninstallDialog inherits Dialog {
    title: Install.step == "done" ? "Nerve is removed"
        : Install.step == "working" ? "Uninstall Nerve"
        : "Uninstall Nerve?";
    subtitle: Install.step == "done" ? (Install.purge ? "The node, the app and the node's data are gone from this machine." : "The node and the app are gone. The node's data stays; install Nerve again, and the node takes it up.")
        : Install.step == "working" ? ""
        : "The service, its user nerve, the program, its menu entry and its link handler go. Choose what happens to the node's data.";
    card-width: 600px;
    close => {
        if (Install.step == "done") {
            Install.close();
        } else if (Install.step != "working") {
            Install.uninstall-open = false;
        }
    }
    VerticalLayout {
        Reveal {
            shown: Install.step == "choose";
            VerticalLayout {
                spacing: Space.xl;
                UninstallChoice { }
                DialogButtons {
                    error: Install.error;
                    error-title: "Uninstalling did not finish";
                    Button {
                        text: "Cancel";
                        kind: ButtonKind.ghost;
                        clicked => {
                            Install.uninstall-open = false;
                        }
                    }
                    Button {
                        text: Install.purge ? "Uninstall and delete the data" : "Uninstall";
                        icon: @image-url("icons/trash.svg");
                        kind: ButtonKind.danger;
                        clicked => {
                            Install.uninstall();
                        }
                    }
                }
            }
        }
        Reveal {
            shown: Install.step == "working";
            Working { }
        }
        Reveal {
            shown: Install.step == "done";
            VerticalLayout {
                spacing: Space.xl;
                DidList { }
                DialogButtons {
                    Button {
                        text: "Close Nerve";
                        kind: ButtonKind.primary;
                        clicked => {
                            Install.close();
                        }
                    }
                }
            }
        }
    }
}

// A node that reaches this node's centers through the relay: which centers,
// and its own limits, for a relay behind this one that carries many nodes.
export component RelayNodeDialog inherits Dialog {
    title: Prefs.relay-edit-name;
    subtitle: "A node that reaches this node's centers through the relay.";
    card-width: 540px;
    close => {
        Prefs.relay-edit-open = false;
    }
    Field {
        label: "Centers it may reach";
        hint: "None ticked: every https center of this node, also one paired later.";
        VerticalLayout {
            spacing: Space.sm;
            for p[i] in Prefs.relay-edit-centers: CheckBox {
                checked: p.on;
                text: p.name;
                toggled(on) => {
                    Prefs.relay-edit-pick(i, on);
                }
            }
        }
    }
    Field {
        label: "Limits";
        hint: Prefs.relay-edit-own ? "For a relay behind this one, which carries many nodes." : "The limits every node of the relay has.";
        VerticalLayout {
            spacing: Space.md;
            HorizontalLayout {
                alignment: start;
                Segmented {
                    options: ["The relay's", "Its own"];
                    current: Prefs.relay-edit-own ? 1 : 0;
                    chosen(i) => {
                        Prefs.relay-edit-own = i == 1;
                    }
                }
            }
            Reveal {
                shown: Prefs.relay-edit-own;
                HorizontalLayout {
                    spacing: Space.md;
                    Field {
                        label: "Tunnels at once";
                        TextField {
                            text <=> Prefs.relay-edit-links;
                            label: "Tunnels at once";
                        }
                    }
                    Field {
                        label: "Tunnels opened a minute";
                        TextField {
                            text <=> Prefs.relay-edit-opens;
                            label: "Tunnels opened a minute";
                        }
                    }
                }
            }
        }
    }
    DialogButtons {
        error: Prefs.relay-edit-error;
        Button {
            text: "Cancel";
            kind: ButtonKind.ghost;
            clicked => {
                Prefs.relay-edit-open = false;
            }
        }
        Button {
            text: "Save";
            kind: ButtonKind.primary;
            busy: Prefs.relay-edit-busy;
            clicked => {
                Prefs.relay-edit-save();
            }
        }
    }
}
