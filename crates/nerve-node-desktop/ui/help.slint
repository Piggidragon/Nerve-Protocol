// Help: short questions and answers on what people do with the app, its
// keys, and behind its own part every nerve-node command by what it is for,
// read from the CLI's own definition (nerve_node::cli::help), the same list
// the center's help page shows. Each action in the app runs one of them.

import { Theme, Type, Space, Radius, Tone } from "theme.slint";
import { HelpSection, HelpCard } from "data.slint";
import { Manual } from "store.slint";
import {
    Button, ButtonKind, Card, PageHeader, PageFrame, Divider, Code, Fit, Reveal, Expander, SectionTitle,
} from "widgets.slint";

component CommandCard inherits Card {
    in property <HelpCard> card;
    pad: 0;
    gap: 0;
    VerticalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.lg;
        padding-bottom: Space.md;
        Text {
            text: root.card.name;
            color: Theme.text;
            font-size: Type.body;
            font-weight: Type.semibold;
            font-family: Type.mono;
        }
        Reveal {
            shown: root.card.about != "";
            gap: 4px;
            Text {
                text: root.card.about;
                color: Theme.text-muted;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }
    }
    for v[i] in root.card.verbs: Fit {
        Divider { }
        VerticalLayout {
            padding-left: Space.xl;
            padding-right: Space.xl;
            padding-top: Space.md;
            padding-bottom: Space.md;
            spacing: 6px;
            Code {
                text: v.usage;
            }
            Text {
                text: v.about;
                color: Theme.text;
                font-size: Type.small;
                wrap: word-wrap;
            }
            for a in v.args: Fit {
                HorizontalLayout {
                    spacing: Space.md;
                    Text {
                        width: 200px;
                        text: a.name;
                        color: Theme.text-muted;
                        font-size: Type.caption;
                        font-family: Type.mono;
                        wrap: char-wrap;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: a.about;
                        color: Theme.text-muted;
                        font-size: Type.caption;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// An answer: plain text, as long as it needs.
component Answer inherits Text {
    color: Theme.text-muted;
    font-size: Type.body;
    wrap: word-wrap;
}

// A key or keys, and what they do.
component KeyRow {
    in property <string> keys;
    in property <string> does;
    HorizontalLayout {
        spacing: Space.lg;
        Rectangle {
            width: 150px;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    background: Theme.inset;
                    border-radius: Radius.sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: root.keys;
                            color: Theme.text;
                            font-size: Type.small;
                            font-family: Type.mono;
                        }
                    }
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.does;
            color: Theme.text-muted;
            font-size: Type.body;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component HelpPage inherits PageFrame {
    gap: Space.md;
    PageHeader {
        icon: @image-url("icons/help.svg");
        title: "Help";
        Button {
            text: "User guide";
            icon: @image-url("icons/external.svg");
            kind: ButtonKind.ghost;
            clicked => {
                Platform.open-url("https://github.com/Piggidragon/Nerve-Protocol/tree/main/docs/user");
            }
        }
    }
    Rectangle {
        height: Space.xs;
    }
    SectionTitle {
        text: "Questions";
        icon: @image-url("icons/help.svg");
    }
    Expander {
        title: "How do I pair a center?";
        open: Manual.open == 0;
        toggled => {
            Manual.open = Manual.open == 0 ? -1 : 0;
        }
        Answer {
            text: "In the center's web UI, press Pair a machine and copy the link. Here, press Pair a center on Centers and paste it. Check where it leads, then press Pair. A nerve:// link you click opens here too.";
        }
    }
    Expander {
        title: "A new center may do nothing. How do I allow something?";
        open: Manual.open == 1;
        toggled => {
            Manual.open = Manual.open == 1 ? -1 : 1;
        }
        Answer {
            text: "On Permissions, pick the center. Add an allow rule for a command, give it folders and choose folder mode, or choose user mode for a while.";
        }
    }
    Expander {
        title: "A call was refused. How do I allow it?";
        open: Manual.open == 2;
        toggled => {
            Manual.open = Manual.open == 2 ? -1 : 2;
        }
        Answer {
            text: "On Audit, choose Refused. Allow lets that call run from now on, Allow as wildcard the program with anything after it. Deny keeps it refused.";
        }
    }
    Expander {
        title: "What do the modes mean?";
        open: Manual.open == 3;
        toggled => {
            Manual.open = Manual.open == 3 ? -1 : 3;
        }
        Answer {
            text: "Allowlist: only what an allow rule names. Folder: what each of the center's folders allows. User: anything you may do, protected files aside. Deny rules count in every mode.";
        }
    }
    Expander {
        title: "How do I stop everything at once?";
        open: Manual.open == 4;
        toggled => {
            Manual.open = Manual.open == 4 ? -1 : 4;
        }
        Answer {
            text: "Press Panic on the Overview. Every link ends and nothing runs until you press Unlock.";
        }
    }
    Expander {
        title: "How do I let a command run with sudo?";
        open: Manual.open == 5;
        toggled => {
            Manual.open = Manual.open == 5 ? -1 : 5;
        }
        Answer {
            text: "Turn sudo on under Permissions with your password, and add the command to the center's Sudo list.";
        }
    }
    Expander {
        title: "Why give commands an account of their own?";
        open: Manual.open == 6;
        toggled => {
            Manual.open = Manual.open == 6 ? -1 : 6;
        }
        Answer {
            text: "Commands run as the account under Settings, General. If that is you, a command could change Nerve itself. An account of their own keeps them away from your files and from Nerve.";
        }
    }
    Expander {
        title: "How do I move the node to another machine?";
        open: Manual.open == 7;
        toggled => {
            Manual.open = Manual.open == 7 ? -1 : 7;
        }
        Answer {
            text: "Under Settings, Backup: back it up here and restore it there. The passphrase protects the file.";
        }
    }
    Expander {
        title: "The node does not run. What now?";
        open: Manual.open == 8;
        toggled => {
            Manual.open = Manual.open == 8 ? -1 : 8;
        }
        Answer {
            text: "Press Start on the Overview. If it stops again, the Log's Problems say why.";
        }
    }
    Expander {
        title: "How do I update or uninstall Nerve?";
        open: Manual.open == 9;
        toggled => {
            Manual.open = Manual.open == 9 ? -1 : 9;
        }
        Answer {
            text: "Under Settings, App.";
        }
    }
    Rectangle {
        height: Space.md;
    }
    SectionTitle {
        text: "Reference";
        icon: @image-url("icons/book.svg");
    }
    Expander {
        title: "Keyboard shortcuts";
        open: Manual.open == 10;
        toggled => {
            Manual.open = Manual.open == 10 ? -1 : 10;
        }
        icon: @image-url("icons/keyboard.svg");
        KeyRow {
            keys: "Ctrl+1 … Ctrl+7";
            does: "Overview, Centers, Permissions, Audit, Log, Settings, Help";
        }
        KeyRow {
            keys: "Ctrl+R, F5";
            does: "Read the page again";
        }
        KeyRow {
            keys: "Esc";
            does: "Close a dialog";
        }
        KeyRow {
            keys: "Enter";
            does: "The dialog's main button";
        }
        KeyRow {
            keys: "Tab, Shift+Tab";
            does: "The next or the last control";
        }
        KeyRow {
            keys: "Space";
            does: "Press a button, tick a box";
        }
        KeyRow {
            keys: "← →";
            does: "Choose in a row of choices or tabs";
        }
    }
    Expander {
        title: "Command reference";
        open: Manual.open == 11;
        toggled => {
            Manual.open = Manual.open == 11 ? -1 : 11;
        }
        icon: @image-url("icons/book.svg");
        Answer {
            text: "Every action here runs one of these nerve-node commands, with the same checks and audit records.";
        }
        for s in Manual.sections: Fit {
            VerticalLayout {
                spacing: Space.md;
                padding-top: Space.md;
                VerticalLayout {
                    Text {
                        text: s.name;
                        color: Theme.text;
                        font-size: Type.heading;
                        font-weight: Type.semibold;
                    }
                    Reveal {
                        shown: s.about != "";
                        gap: 4px;
                        Text {
                            text: s.about;
                            color: Theme.text-muted;
                            font-size: Type.small;
                            wrap: word-wrap;
                        }
                    }
                }
                for c in s.cards: Fit {
                    CommandCard {
                        card: c;
                    }
                }
            }
        }
    }
}
