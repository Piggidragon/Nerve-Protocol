// Overview: whether the node runs, its centers at a glance, and the switch
// that stops everything (panic) or allows it again (unlock).

import { Theme, Type, Space, Radius, Tone } from "theme.slint";
import { Page, Load } from "data.slint";
import { Store } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, StatusDot, IconTile, Banner, Loading, PageHeader,
    PageFrame, SectionTitle, StatTile, Divider, Icon, Reveal, Fit,
} from "widgets.slint";

export component OverviewPage inherits PageFrame {
    gap: 0;
    PageHeader {
        title: "Overview";
        subtitle: "How the node on this machine is doing.";
        error-title: "The node did not answer";
        error: Store.status-error;
        error-action: "Try again";
        error-acted => {
            Store.refresh();
        }
        Button {
            text: "Refresh";
            icon: @image-url("icons/refresh.svg");
            kind: ButtonKind.ghost;
            clicked => {
                Store.refresh();
            }
        }
    }

    if Store.status-load == Load.loading && Store.status.state == "": Loading { }

    Reveal {
        shown: Store.status.state != "";
        gap: Space.xxl;
        Card {
            pad: Space.xxl;
            HorizontalLayout {
                spacing: Space.xl;
                VerticalLayout {
                    alignment: start;
                    IconTile {
                        size: 52px;
                        tone: Store.status.tone;
                        icon: Store.status.state == "locked" ? @image-url("icons/lock.svg")
                            : Store.status.state == "running" ? @image-url("icons/activity.svg")
                            : @image-url("icons/wait.svg");
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: Store.status.title;
                        color: Theme.text;
                        font-size: 19px;
                        font-weight: Type.semibold;
                        wrap: word-wrap;
                    }
                    Reveal {
                        shown: Store.status.detail != "";
                        gap: 6px;
                        Text {
                            text: Store.status.detail;
                            color: Theme.text-muted;
                            font-size: Type.body;
                            wrap: word-wrap;
                        }
                    }
                    Reveal {
                        shown: Store.status.confinement != "";
                        gap: 10px;
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("icons/shield.svg");
                                    colorize: Theme.text-faint;
                                    size: 14px;
                                }
                            }
                            Text {
                                text: "Confinement: " + Store.status.confinement;
                                color: Theme.text-faint;
                                font-size: Type.caption;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Space.sm;
                        if Store.status.state == "locked": Button {
                            text: "Unlock";
                            icon: @image-url("icons/unlock.svg");
                            kind: ButtonKind.primary;
                            busy: Store.busy == "node";
                            clicked => {
                                Store.unlock();
                            }
                        }
                        if Store.status.state != "locked": Button {
                            text: "Panic";
                            icon: @image-url("icons/octagon.svg");
                            kind: ButtonKind.danger-soft;
                            busy: Store.busy == "node";
                            why-disabled: "Ends every link and runs nothing until you unlock";
                            clicked => {
                                Store.panic();
                            }
                        }
                    }
                }
            }
        }
    }

    // The installed service: its state, and starting and stopping it.
    Reveal {
        shown: Store.service-state != "" && Store.service-state != "none";
        gap: Space.lg;
        Card {
            pad: Space.xl;
            HorizontalLayout {
                spacing: Space.lg;
                VerticalLayout {
                    alignment: center;
                    IconTile {
                        icon: @image-url("icons/server.svg");
                        tone: Store.service-state == "running" ? Tone.ok
                            : Store.service-state == "failed" ? Tone.danger
                            : Store.service-state == "stopped" ? Tone.warn
                            : Tone.accent;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: Store.service-state == "running" ? "The service runs"
                            : Store.service-state == "failed" ? "The service stopped with an error"
                            : Store.service-state == "stopped" ? "The service is stopped"
                            : Store.service-state == "starting" ? "The service starts…"
                            : "The service stops…";
                        color: Theme.text;
                        font-size: Type.body;
                        font-weight: Type.semibold;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Store.service-state == "running" && Store.restart-due ? "Some changes wait for a restart: the node takes them when it starts again."
                            : Store.service-state == "running" ? (Store.service-enabled ? "The node runs in the background as the user nerve, and starts with the machine." : "The node runs in the background as the user nerve.")
                            : Store.service-state == "failed" ? "The Log page says why. Start it again once that is fixed."
                            : Store.service-state == "stopped" ? (Store.service-enabled ? "Start it to link this machine to its centers. It starts again with the machine." : "Start it to link this machine to its centers.")
                            : "One moment.";
                        color: Theme.text-muted;
                        font-size: Type.small;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Space.sm;
                        if Store.service-state == "stopped" || Store.service-state == "failed": Button {
                            text: "Start";
                            icon: @image-url("icons/play.svg");
                            kind: ButtonKind.primary;
                            busy: Store.busy == "service-start";
                            clicked => {
                                Store.service("start");
                            }
                        }
                        if Store.service-state == "running": Button {
                            text: "Restart";
                            icon: @image-url("icons/refresh.svg");
                            kind: Store.restart-due ? ButtonKind.primary : ButtonKind.ghost;
                            busy: Store.busy == "service-restart";
                            enabled: Store.busy != "service-stop";
                            clicked => {
                                Store.service("restart");
                            }
                        }
                        if Store.service-state == "running": Button {
                            text: "Stop";
                            icon: @image-url("icons/stop.svg");
                            busy: Store.busy == "service-stop";
                            enabled: Store.busy != "service-restart";
                            clicked => {
                                Store.service("stop");
                            }
                        }
                    }
                }
            }
        }
    }

    Reveal {
        shown: Store.service-state == "none";
        gap: Space.lg;
        Banner {
            tone: Tone.warn;
            title: "The node is not installed as a service";
            text: "The app is here, but the service is gone. Open the downloaded nerve-node-desktop again and install, or run nerve-node-desktop install as root (on Windows, as administrator).";
        }
    }

    Reveal {
        shown: Store.commands-as-you;
        gap: Space.lg;
        Banner {
            tone: Tone.warn;
            title: "Commands run as you";
            text: "Commands from centers run as " + Store.commands-account + ", who changes Nerve without a password. A command could change its settings too. Give commands an account of their own.";
            action: "Separate account";
            acted => {
                Store.separate-account();
            }
        }
    }

    Reveal {
        shown: Store.status.warnings.length > 0;
        gap: Space.xxl;
        VerticalLayout {
            spacing: Space.sm;
            for warning in Store.status.warnings: Banner {
                tone: Tone.warn;
                text: warning;
            }
        }
    }

    Reveal {
        shown: Store.status.state != "";
        gap: Space.xxl;
        HorizontalLayout {
            spacing: Space.lg;
            StatTile {
                icon: @image-url("icons/centers.svg");
                label: "Centers";
                value: Store.status.centers == 0 ? "None paired"
                    : Store.status.centers == 1 ? "1 paired" : Store.status.centers + " paired";
                detail: Store.status.state != "running" ? "No link while the node does not run"
                    : Store.status.connected + " of " + Store.status.centers + " connected";
                tone: Store.status.connected > 0 ? Tone.ok : Tone.accent;
            }
            StatTile {
                icon: @image-url("icons/key.svg");
                label: "Sudo";
                value: Store.status.sudo-on ? "On" : "Off";
                detail: Store.status.sudo-on ? "Commands on the sudo list run with sudo" : "No command runs with sudo";
                tone: Store.status.sudo-on ? Tone.warn : Tone.accent;
            }
            StatTile {
                icon: @image-url("icons/cpu.svg");
                label: "Limits per command";
                value: Store.status.limits;
                detail: "Memory, CPU and processes of each command";
            }
        }
    }

    Reveal {
        shown: Store.status.state != "";
        gap: Space.xxl;
        VerticalLayout {
            SectionTitle {
                text: "Centers";
                Button {
                    text: "Manage";
                    kind: ButtonKind.ghost;
                    small: true;
                    clicked => {
                        Store.show(Page.centers);
                    }
                }
            }
            Reveal {
                shown: Store.centers.length == 0;
                gap: Space.md;
                Card {
                    HorizontalLayout {
                        spacing: Space.lg;
                        Text {
                            horizontal-stretch: 1;
                            text: "No center is paired yet. Pair one to let its agents use this machine, with only what you allow.";
                            color: Theme.text-muted;
                            font-size: Type.body;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Set up…";
                            kind: ButtonKind.ghost;
                            clicked => {
                                Store.setup-start();
                            }
                        }
                        Button {
                            text: "Pair a center";
                            icon: @image-url("icons/plus.svg");
                            kind: ButtonKind.primary;
                            clicked => {
                                Store.pair-start();
                            }
                        }
                    }
                }
            }
            Reveal {
                shown: Store.centers.length > 0;
                gap: Space.md;
                Card {
                    pad: 0;
                    gap: 0;
                    for c[i] in Store.centers: Fit {
                        Divider {
                            visible: i > 0;
                            height: i > 0 ? 1px : 0;
                        }
                        HorizontalLayout {
                            padding-left: Space.xl;
                            padding-right: Space.xl;
                            padding-top: 14px;
                            padding-bottom: 14px;
                            spacing: Space.md;
                            VerticalLayout {
                                alignment: center;
                                StatusDot {
                                    tone: c.link-tone;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: c.name;
                                    color: Theme.text;
                                    font-size: Type.body;
                                    font-weight: Type.semibold;
                                    overflow: elide;
                                }
                                Text {
                                    text: c.url;
                                    color: Theme.text-faint;
                                    font-size: Type.caption;
                                    font-family: Type.mono;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    text: c.mode;
                                    tone: Tone.accent;
                                }
                            }
                            Text {
                                min-width: 120px;
                                text: c.link;
                                color: Theme.tone(c.link-tone);
                                font-size: Type.small;
                                font-weight: Type.medium;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
