// Log: what the node did, newest first, as `nerve-node log --follow` gives
// it while the page is open.

import { Theme, Type, Space, Radius, Tone } from "theme.slint";
import { Load, LogRow } from "data.slint";
import { Logs, Store } from "store.slint";
import {
    Button, ButtonKind, Card, Pill, Banner, Loading, PageHeader, PageFrame, EmptyState, Segmented,
    ListRow, StatusDot, Reveal, MoreFoot,
} from "widgets.slint";

export component LogPage inherits PageFrame {
    gap: 0;
    PageHeader {
        icon: @image-url("icons/log.svg");
        title: "Log";
        error-title: "The log could not be read";
        error: Logs.error;
        Segmented {
            options: ["All", "Problems"];
            current: Logs.problems-only ? 1 : 0;
            chosen(i) => {
                Logs.filter(i == 1);
            }
        }
        Button {
            text: "Clear";
            icon: @image-url("icons/trash.svg");
            kind: ButtonKind.ghost;
            busy: Store.busy == "log-clear";
            clicked => {
                Logs.clear();
            }
        }
    }

    if Logs.load == Load.loading && Logs.rows.length == 0: Loading {
        text: "Reading the log…";
    }

    Reveal {
        shown: Logs.load == Load.ready && Logs.rows.length == 0;
        gap: Space.xxl;
        Card {
            EmptyState {
                icon: @image-url("icons/log.svg");
                title: Logs.problems-only ? "No problems" : "Nothing logged yet";
                text: Logs.problems-only
                    ? "No error or warning in the log."
                    : "The node writes its log while it runs.";
            }
        }
    }

    Reveal {
        shown: Logs.rows.length > 0;
        gap: Space.xxl;
        Card {
            pad: 0;
            gap: 0;
            for row[i] in Logs.rows: ListRow {
                first: i == 0;
                VerticalLayout {
                    alignment: start;
                    padding-top: 3px;
                    StatusDot {
                        tone: row.tone;
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: Space.sm;
                        Text {
                            text: row.level;
                            color: row.tone == Tone.neutral ? Theme.text-muted : Theme.tone(row.tone);
                            font-size: Type.caption;
                            font-weight: Type.semibold;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.when;
                            color: Theme.text-faint;
                            font-size: Type.caption;
                            accessible-label: row.when-exact;
                        }
                    }
                    Text {
                        text: row.msg;
                        color: Theme.text;
                        font-size: Type.small;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    Reveal {
        shown: Logs.rows.length >= Logs.limit;
        gap: Space.lg;
        MoreFoot {
            text: Logs.limit < 1000 ? "The newest " + Logs.rows.length + " lines."
                : "The newest " + Logs.rows.length + " lines. Older ones stay in the log file.";
            more: Logs.limit < 1000;
            clicked => {
                Logs.more();
            }
        }
    }
}
