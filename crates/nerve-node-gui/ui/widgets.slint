// The app's own controls, drawn from the tokens in theme.slint. Pages build
// from these only, so a button or a card looks the same everywhere.

import { ScrollView } from "std-widgets.slint";
import { Theme, Type, Space, Radius, Size, Tone } from "theme.slint";

export component Icon inherits Image {
    in property <length> size: Size.icon;
    width: self.size;
    height: self.size;
    image-fit: contain;
}

// Three dots that pulse: the app is waiting for the node.
export component Dots {
    in property <color> color: Theme.text-muted;
    in property <length> dot: 6px;
    HorizontalLayout {
        spacing: root.dot * 0.75;
        alignment: center;
        for i in 3: Rectangle {
            width: root.dot;
            height: root.dot;
            border-radius: root.dot / 2;
            background: root.color;
            opacity: 0.3 + 0.7 * Math.abs(Math.sin(animation-tick() / 1100ms * 180deg - i * 45deg));
        }
    }
}

export enum ButtonKind { primary, secondary, ghost, danger, danger-soft }

export component Button {
    in property <string> text;
    in property <image> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> small;
    in property <bool> enabled: true;
    in property <bool> busy;
    // Why the button does nothing now; shown below it by the page, read by
    // screen readers here.
    in property <string> why-disabled;
    callback clicked();

    property <bool> active: root.enabled && !root.busy;
    property <bool> has-icon: root.icon.width > 0;
    property <length> pad: root.small ? 10px : 14px;

    min-height: root.small ? Size.control-sm : Size.control;
    min-width: root.text == "" ? self.min-height : 0;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.why-disabled;
    accessible-enabled: root.active;
    accessible-action-default => {
        if (root.active) {
            root.clicked();
        }
    }
    forward-focus: focus;

    background := Rectangle {
        border-radius: Radius.md;
        border-width: root.kind == ButtonKind.secondary ? 1px : 0;
        border-color: Theme.border-strong;
        background: transparent;
        animate background { duration: 110ms; }
        states [
            primary-pressed when root.kind == ButtonKind.primary && touch.pressed: { background: Theme.accent-pressed; }
            primary-hover when root.kind == ButtonKind.primary && touch.has-hover: { background: Theme.accent-hover; }
            primary when root.kind == ButtonKind.primary: { background: Theme.accent; }
            danger-pressed when root.kind == ButtonKind.danger && touch.pressed: { background: Theme.danger-pressed; }
            danger-hover when root.kind == ButtonKind.danger && touch.has-hover: { background: Theme.danger-hover; }
            danger when root.kind == ButtonKind.danger: { background: Theme.danger; }
            soft-hover when root.kind == ButtonKind.danger-soft && touch.has-hover: {
                background: Theme.danger-soft;
                border-width: 1px;
                border-color: Theme.danger.transparentize(0.55);
            }
            soft when root.kind == ButtonKind.danger-soft: { background: Theme.danger-soft; }
            secondary-pressed when root.kind == ButtonKind.secondary && touch.pressed: { background: Theme.pressed; }
            secondary-hover when root.kind == ButtonKind.secondary && touch.has-hover: { background: Theme.surface-alt; }
            secondary when root.kind == ButtonKind.secondary: { background: Theme.surface; }
            ghost-pressed when touch.pressed: { background: Theme.pressed; }
            ghost-hover when touch.has-hover: { background: Theme.hover; }
        ]
    }

    // Keyboard focus only: a click does not leave a ring behind.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Radius.md + 3px;
        border-width: 2px;
        border-color: Theme.accent.transparentize(0.35);
        visible: focus.has-focus;
    }

    property <color> fg: root.kind == ButtonKind.primary ? Theme.on-accent
        : root.kind == ButtonKind.danger ? Theme.on-danger
        : root.kind == ButtonKind.danger-soft ? Theme.danger
        : Theme.text;

    HorizontalLayout {
        padding-left: root.text == "" ? 0 : root.pad;
        padding-right: root.text == "" ? 0 : root.pad;
        spacing: 7px;
        alignment: center;
        opacity: root.enabled ? 1 : 0.45;
        if root.busy: Dots {
            color: root.fg;
            dot: 5px;
        }
        if !root.busy && root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                colorize: root.fg;
                size: root.small ? 14px : Size.icon;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: root.small ? Type.small : Type.body;
            font-weight: Type.medium;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        enabled: root.active;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component Card inherits Rectangle {
    in property <length> pad: Space.xl;
    in property <length> gap: Space.md;
    background: Theme.surface;
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

// A short label with the colour of what it says.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <bool> dot;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    height: 22px;
    border-radius: Radius.pill;
    background: Theme.tone-soft(root.tone);
    HorizontalLayout {
        padding-left: root.dot ? 8px : 9px;
        padding-right: 9px;
        spacing: 6px;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.tone(root.tone);
            }
        }
        Text {
            text: root.text;
            color: Theme.tone(root.tone);
            font-size: Type.caption;
            font-weight: Type.semibold;
            vertical-alignment: center;
        }
    }
}

// A dot with a soft ring: the state of a link.
export component StatusDot {
    in property <Tone> tone: Tone.neutral;
    in property <length> size: 8px;
    width: self.size + 6px;
    height: self.size + 6px;
    Rectangle {
        border-radius: self.width / 2;
        background: Theme.tone-soft(root.tone);
    }
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: Theme.tone(root.tone);
    }
}

// An icon in a soft square, at the head of a row or a card.
export component IconTile inherits Rectangle {
    in property <image> icon;
    in property <Tone> tone: Tone.accent;
    in property <length> size: 36px;
    width: root.size;
    height: root.size;
    border-radius: Radius.md;
    background: Theme.tone-soft(root.tone);
    Icon {
        source: root.icon;
        colorize: Theme.tone(root.tone);
        size: root.size * 0.5;
    }
}

// Something the owner should know: an error, a warning, a note.
export component Banner inherits Rectangle {
    in property <Tone> tone: Tone.danger;
    in property <string> title;
    in property <string> text;
    in property <string> action;
    callback acted();
    background: Theme.tone-soft(root.tone);
    border-radius: Radius.md;
    border-width: 1px;
    border-color: Theme.tone(root.tone).transparentize(0.7);
    accessible-role: AccessibleRole.text;
    accessible-label: root.title + " " + root.text;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon {
                source: root.tone == Tone.ok ? @image-url("icons/ok.svg")
                    : root.tone == Tone.accent || root.tone == Tone.neutral ? @image-url("icons/info.svg")
                    : @image-url("icons/alert.svg");
                colorize: Theme.tone(root.tone);
            }
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            alignment: center;
            if root.title != "": Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.body;
                font-weight: Type.semibold;
                wrap: word-wrap;
            }
            if root.text != "": Text {
                text: root.text;
                color: root.title == "" ? Theme.text : Theme.text-muted;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            Button {
                text: root.action;
                kind: ButtonKind.ghost;
                small: true;
                clicked => {
                    root.acted();
                }
            }
        }
    }
}

// What a page shows when it has nothing to show yet.
export component EmptyState {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    VerticalLayout {
        alignment: center;
        spacing: Space.md;
        padding-top: 56px;
        padding-bottom: 56px;
        padding-left: Space.page;
        padding-right: Space.page;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: Theme.accent-soft;
                Icon {
                    source: root.icon;
                    colorize: Theme.accent-text;
                    size: 26px;
                }
            }
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Type.heading;
            font-weight: Type.semibold;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                max-width: 440px;
                text: root.text;
                color: Theme.text-muted;
                font-size: Type.body;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: Space.sm;
            padding-top: Space.xs;
            @children
        }
    }
}

export component Loading {
    in property <string> text: "Asking the node…";
    VerticalLayout {
        alignment: center;
        spacing: Space.lg;
        padding-top: 72px;
        padding-bottom: 72px;
        Dots {
            dot: 7px;
            color: Theme.accent;
        }
        Text {
            text: root.text;
            color: Theme.text-muted;
            font-size: Type.small;
            horizontal-alignment: center;
        }
    }
}

export component PageHeader {
    in property <string> title;
    in property <string> subtitle;
    HorizontalLayout {
        spacing: Space.xl;
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            alignment: start;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.title;
                font-weight: Type.semibold;
                accessible-role: AccessibleRole.text;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-muted;
                font-size: Type.body;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: Space.sm;
                @children
            }
        }
    }
}

// The head of a group on a page.
export component SectionTitle {
    in property <string> text;
    in property <string> detail;
    HorizontalLayout {
        spacing: Space.sm;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Type.heading;
            font-weight: Type.semibold;
            vertical-alignment: center;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-faint;
            font-size: Type.small;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        @children
    }
}

export component NavItem {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        border-radius: Radius.md;
        background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        border-width: root.selected && !Theme.dark ? 1px : 0;
        border-color: Theme.border;
        animate background { duration: 110ms; }
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                colorize: root.selected ? Theme.accent : Theme.text-muted;
            }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: Type.body;
            font-weight: root.selected ? Type.semibold : Type.medium;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A row of choices of which one is on.
export component Segmented {
    in property <[string]> options;
    in property <int> current;
    callback chosen(int);
    horizontal-stretch: 0;
    height: Size.control;
    Rectangle {
        background: Theme.inset;
        border-radius: Radius.md;
        border-width: 1px;
        border-color: Theme.border;
    }
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            border-radius: Radius.sm;
            background: i == root.current ? Theme.surface : t.has-hover ? Theme.hover : transparent;
            border-width: i == root.current && !Theme.dark ? 1px : 0;
            border-color: Theme.border;
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: i == root.current;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: option;
                    color: i == root.current ? Theme.text : Theme.text-muted;
                    font-size: Type.small;
                    font-weight: i == root.current ? Type.semibold : Type.medium;
                    vertical-alignment: center;
                }
            }
            t := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.chosen(i);
                }
            }
        }
    }
}

// An on/off switch. It shows what the node says: a click asks for the
// change, and the page sets `checked` once the node made it.
export component Switch {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.toggled(!root.checked);
    }
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        border-radius: self.height / 2;
        background: root.checked ? Theme.accent : Theme.border-strong;
        animate background { duration: 140ms; }
        Rectangle {
            width: 18px;
            height: 18px;
            y: 2px;
            x: root.checked ? parent.width - self.width - 2px : 2px;
            border-radius: 9px;
            background: #ffffff;
            animate x { duration: 140ms; easing: ease-out; }
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

export component TextField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono;
    in property <bool> invalid;
    in property <bool> enabled: true;
    in property <string> label;
    callback accepted(string);
    callback edited(string);
    forward-focus: input;
    height: 38px;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    Rectangle {
        background: root.enabled ? Theme.surface : Theme.surface-alt;
        border-radius: Radius.md;
        border-width: input.has-focus ? 2px : 1px;
        border-color: root.invalid ? Theme.danger : input.has-focus ? Theme.accent : Theme.border-strong;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Rectangle {
            clip: true;
            input := TextInput {
                text <=> root.text;
                enabled: root.enabled;
                single-line: true;
                color: Theme.text;
                font-size: Type.body;
                font-family: root.mono ? Type.mono : "";
                vertical-alignment: center;
                selection-background-color: Theme.accent.transparentize(0.6);
                selection-foreground-color: Theme.text;
                accepted => {
                    root.accepted(self.text);
                }
                edited => {
                    root.edited(self.text);
                }
            }
            Text {
                text: root.placeholder;
                visible: root.text == "";
                color: Theme.text-faint;
                font-size: Type.body;
                font-family: root.mono ? Type.mono : "";
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// A label over a control, with a hint below.
export component Field {
    in property <string> label;
    in property <string> hint;
    VerticalLayout {
        spacing: 6px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Type.small;
            font-weight: Type.semibold;
        }
        @children
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.text-muted;
            font-size: Type.caption;
            wrap: word-wrap;
        }
    }
}

// One fact: a label on the left, its value on the right.
export component InfoRow {
    in property <string> label;
    in property <string> value;
    in property <bool> mono;
    in property <Tone> tone: Tone.neutral;
    HorizontalLayout {
        spacing: Space.lg;
        Text {
            width: 132px;
            text: root.label;
            color: Theme.text-muted;
            font-size: Type.small;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: root.tone == Tone.neutral ? Theme.text : Theme.tone(root.tone);
            font-size: Type.small;
            font-family: root.mono ? Type.mono : "";
            wrap: word-wrap;
        }
    }
}

// A command line, a path or a rule, as the node has it.
export component Code inherits Rectangle {
    in property <string> text;
    in property <length> size: Type.small;
    background: Theme.inset;
    border-radius: Radius.sm;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: root.size;
            font-family: Type.mono;
            wrap: char-wrap;
        }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A window over the page; the page behind waits.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> card-width: Size.dialog;
    callback close();
    background: Theme.scrim;
    // Clicks do not reach the page behind.
    TouchArea { }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }
    }
    card := Rectangle {
        width: min(root.card-width, root.width - 48px);
        height: min(body.preferred-height, root.height - 48px);
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) * 0.42);
        background: Theme.surface;
        border-radius: Radius.xl;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: #0000004d;
        accessible-role: groupbox;
        accessible-label: root.title;
        body := VerticalLayout {
            width: card.width;
            padding: Space.xxl;
            spacing: Space.xl;
            HorizontalLayout {
                spacing: Space.md;
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: Type.semibold;
                        wrap: word-wrap;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        color: Theme.text-muted;
                        font-size: Type.body;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: start;
                    Button {
                        icon: @image-url("icons/x.svg");
                        kind: ButtonKind.ghost;
                        small: true;
                        accessible-label: "Close";
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
            @children
        }
    }
}

// The buttons at the foot of a dialog, the main one last.
export component DialogButtons inherits HorizontalLayout {
    alignment: end;
    spacing: Space.sm;
    padding-top: Space.xs;
}

// A short note in the corner that something was done, or failed.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.ok;
    background: Theme.dark ? #2a2f3a : #1c2029;
    border-radius: Radius.lg;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000040;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        padding-top: 11px;
        padding-bottom: 11px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon {
                source: root.tone == Tone.danger ? @image-url("icons/alert.svg") : @image-url("icons/ok.svg");
                colorize: root.tone == Tone.danger ? #ff8a90 : #5fd69d;
            }
        }
        Text {
            text: root.text;
            color: #f3f4f6;
            font-size: Type.small;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

// A page: its content scrolls, at most Size.content-max wide, in the middle.
export component PageFrame {
    // The side margins grow on a wide window, so the content keeps its width.
    property <length> side: max(Space.page, (scroll.visible-width - Size.content-max) / 2);
    scroll := ScrollView {
        width: root.width;
        height: root.height;
        content-width: self.visible-width;
        content-height: column.preferred-height;
        column := VerticalLayout {
            width: scroll.visible-width;
            padding-left: root.side;
            padding-right: root.side;
            padding-top: 28px;
            padding-bottom: Space.page;
            spacing: Space.xxl;
            alignment: start;
            @children
        }
    }
}

// A number or state at a glance, on the overview.
export component StatTile inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <Tone> tone: Tone.accent;
    background: Theme.surface;
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Theme.border;
    // The same start for every tile, so a row of them shares the width.
    horizontal-stretch: 1;
    preferred-width: 160px;
    VerticalLayout {
        padding: Space.lg + 2px;
        spacing: Space.sm;
        HorizontalLayout {
            spacing: Space.sm;
            VerticalLayout {
                alignment: center;
                Icon {
                    source: root.icon;
                    colorize: Theme.tone(root.tone);
                }
            }
            Text {
                text: root.label;
                color: Theme.text-muted;
                font-size: Type.small;
                font-weight: Type.medium;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 20px;
            font-weight: Type.semibold;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: Theme.text-faint;
            font-size: Type.caption;
            wrap: word-wrap;
        }
    }
}

// A part of a page that is not built yet: what it will hold.
export component Planned inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <image> icon;
    background: Theme.surface;
    border-radius: Radius.lg;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: Space.xl;
        spacing: Space.lg;
        VerticalLayout {
            alignment: start;
            IconTile {
                icon: root.icon;
                tone: Tone.neutral;
            }
        }
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.heading;
                font-weight: Type.semibold;
            }
            Text {
                text: root.text;
                color: Theme.text-muted;
                font-size: Type.small;
                wrap: word-wrap;
            }
            @children
        }
        VerticalLayout {
            alignment: start;
            Pill {
                text: "Coming next";
                tone: Tone.neutral;
            }
        }
    }
}
